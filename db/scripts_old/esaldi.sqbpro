<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="esaldi.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser query pragmas" current="1"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="2806"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="0" parent="0"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="autores" custom_title="0" dock_id="1" table="4,7:mainautores"/><dock_state state="000000ff00000000fd0000000100000002000003020000022dfc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000003020000016100ffffff000002cf0000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="autores" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="67"/><column index="2" value="240"/><column index="3" value="294"/><column index="4" value="127"/><column index="5" value="139"/><column index="6" value="300"/><column index="7" value="300"/><column index="8" value="73"/><column index="9" value="70"/><column index="10" value="67"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="citas" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="54"/><column index="2" value="300"/><column index="3" value="300"/><column index="4" value="64"/><column index="5" value="73"/><column index="6" value="300"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1"></sql><sql name="Comprobar &amp;integridad">CREATE VIEW vista_citas_completa AS
SELECT
    a.id_autor,
    c.id_cita,

    a.autor_es,

    c.cita_es,
    c.cita_original,

    i.id_idioma,
    i.codigo,
    i.idioma_es,
    i.idioma_la,

    n.id_nacion,
    n.nacion_es,
    n.nacion_la,

    e.id_epoca,
    e.epoca_es,
    e.epoca_la

FROM citas c
JOIN autores a   ON a.id_autor   = c.id_autor
LEFT JOIN idiomas i  ON i.id_idioma  = a.id_idioma
LEFT JOIN naciones n ON n.id_nacion  = a.id_nacion
LEFT JOIN epocas e   ON e.id_epoca   = a.id_epoca;
</sql><sql name="Editar vista vista_citas_completa">DROP VIEW IF EXISTS &quot;main&quot;.&quot;vista_citas_completa&quot;;
CREATE VIEW esaldi AS
SELECT
    a.id_autor,
    c.id_cita,

    a.autor_es,

    c.cita_es,
    c.cita_original,

    i.id_idioma,
    i.codigo,
    i.idioma_es,
    i.idioma_la,

    n.id_nacion,
    n.nacion_es,
    n.nacion_la,

    e.id_epoca,
    e.epoca_es,
    e.epoca_la

FROM citas c
JOIN autores a   ON a.id_autor   = c.id_autor
LEFT JOIN idiomas i  ON i.id_idioma  = a.id_idioma
LEFT JOIN naciones n ON n.id_nacion  = a.id_nacion
LEFT JOIN epocas e   ON e.id_epoca   = a.id_epoca</sql><current_tab id="2"/></tab_sql></sqlb_project>
