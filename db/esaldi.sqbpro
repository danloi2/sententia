e="77"/><column index="10" value="91"/><column index="11" value="56"/><column index="12" value="73"/><column index="13" value="123"/><column index="14" value="169"/><column index="15" value="154"/><column index="16" value="162"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1"></sql><sql name="Editar vista vista_citas_detallada">DROP VIEW IF EXISTS &quot;main&quot;.&quot;vista_citas_detallada&quot;;

CREATE VIEW vista_citas_detallada AS
SELECT 
    c.id_cita,
    c.cita_original,
    c.cita_es,
    c.cita_la,
    a.id_autor,
    a.autor_es,
    a.autor_la,
    i.id_idioma,
    i.idioma_es,
    i.idioma_la,
    i.codigo,
    n.id_nacion,
    n.nacion_es,
    n.nacion_la,
    e.epoca_es,
    e.epoca_la
FROM citas c
LEFT JOIN autores a ON c.id_autor = a.id_autor
LEFT JOIN epocas e ON a.id_epoca = e.id_epoca
LEFT JOIN idiomas i ON c.id_idioma = i.id_idioma
LEFT JOIN naciones n ON a.id_nacion = n.id_nacion;
</sql><current_tab id="1"/></tab_sql></sqlb_project>
