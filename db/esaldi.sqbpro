/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="epocas" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="68"/><column index="2" value="154"/><column index="3" value="77"/><column index="4" value="59"/><column index="5" value="162"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="esaldi" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="67"/><column index="2" value="54"/><column index="3" value="240"/><column index="4" value="294"/><column index="5" value="300"/><column index="6" value="300"/><column index="7" value="300"/><column index="8" value="74"/><column index="9" value="56"/><column index="10" value="77"/><column index="11" value="91"/><column index="12" value="73"/><column index="13" value="123"/><column index="14" value="169"/><column index="15" value="68"/><column index="16" value="154"/><column index="17" value="162"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="idiomas" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="74"/><column index="2" value="56"/><column index="3" value="84"/><column index="4" value="91"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="naciones" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="73"/><column index="2" value="123"/><column index="3" value="169"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">-- ✅ TALES (44) y EPICURO (40) YA INSERTADOS
-- ⏭️ SALTAR A: MARCO AURELIO, PLATÓN, ARISTÓTELES

-- 🔹 MARCO AURELIO (id_autor = 41) - 10 citas
INSERT INTO citas (id_cita, id_autor, cita_original, cita_es, cita_la) VALUES
((SELECT IFNULL(MAX(id_cita), 0) + 1 FROM citas), 41, 'Τὸν βίον σου ποιοῦνται αἱ ὑπολήψεις σου.', 'Tu vida la hacen tus pensamientos.', 'Vitam tuam opiniones tuae faciunt.'),
((SELECT IFNULL(MAX(id_cita), 0) + 2 FROM citas), 41, 'Μὴ ταράττεσθαι τὰ ἔξωθεν.', 'No te perturben las cosas externas.', 'Res externae te non perturbent.'),
((SELECT IFNULL(MAX(id_cita), 0) + 3 FROM citas), 41, 'Ζῆν κατὰ φύσιν.', 'Vivir conforme a la naturaleza.', 'Secundum naturam vivere.'),
((SELECT IFNULL(MAX(id_cita), 0) + 4 FROM citas), 41, 'Ὅ,τι συμβαίνει, δικαίως συμβαίνει.', 'Todo sucede justamente.', 'Omnia iuste fiunt.'),
((SELECT IFNULL(MAX(id_cita), 0) + 5 FROM citas), 41, 'ἄνθρωπος ἀνθρώπῳ συγγενής.', 'El ser humano es pariente del ser humano.', 'Homo homini cognatus est.'),
((SELECT IFNULL(MAX(id_cita), 0) + 6 FROM citas), 41, 'ὀλίγον ζῆν, ἀλλὰ καλῶς.', 'Vivir poco, pero bien.', 'Parum vivere, sed bene.'),
((SELECT IFNULL(MAX(id_cita), 0) + 7 FROM citas), 41, 'ἔνδον ἡ εὐδαιμονία.', 'La felicidad está dentro.', 'Felicitas intus est.'),
((SELECT IFNULL(MAX(id_cita), 0) + 8 FROM citas), 41, 'πᾶν παροδικόν.', 'Todo es transitorio.', 'Omnia transitoria sunt.'),
((SELECT IFNULL(MAX(id_cita), 0) + 9 FROM citas), 41, 'μνήμη θανάτου.', 'Recuerdo de la muerte.', 'Memoria mortis.'),
((SELECT IFNULL(MAX(id_cita), 0) + 10 FROM citas), 41, 'ἡ ἀρετὴ αὐτάρκης.', 'La virtud se basta a sí misma.', 'Virtus sibi sufficit.');

-- 🔹 PLATÓN (id_autor = 42) - 10 citas
INSERT INTO citas (id_cita, id_autor, cita_original, cita_es, cita_la) VALUES
((SELECT IFNULL(MAX(id_cita), 0) + 1 FROM citas), 42, 'Ἀνεξέταστος βίος οὐ βιωτὸς.', 'La vida no examinada no merece ser vivida.', 'Vita non examinata non est digna.'),
((SELECT IFNULL(MAX(id_cita), 0) + 2 FROM citas), 42, 'Οὐδεὶς ἑκὼν κακός.', 'Nadie es malo voluntariamente.', 'Nemo sponte malus est.'),
((SELECT IFNULL(MAX(id_cita), 0) + 3 FROM citas), 42, 'ἡ δικαιοσύνη ἁρμονία ψυχῆς.', 'La justicia es armonía del alma.', 'Iustitia harmonia animae est.'),
((SELECT IFNULL(MAX(id_cita), 0) + 4 FROM citas), 42, 'ἡ παιδεία δεύτερος ἥλιος.', 'La educación es un segundo sol.', 'Educatio alter sol est.'),
((SELECT IFNULL(MAX(id_cita), 0) + 5 FROM citas), 42, 'ἡ φιλοσοφία μελέτη θανάτου.', 'La filosofía es preparación para la muerte.', 'Philosophia mortis meditatio est.'),
((SELECT IFNULL(MAX(id_cita), 0) + 6 FROM citas), 42, 'ἡ ψυχὴ ἀθάνατος.', 'El alma es inmortal.', 'Anima immortalis est.'),
((SELECT IFNULL(MAX(id_cita), 0) + 7 FROM citas), 42, 'τὸ ἀγαθὸν μέγιστον μάθημα.', 'El Bien es el mayor conocimiento.', 'Bonum maximum studium est.'),
((SELECT IFNULL(MAX(id_cita), 0) + 8 FROM citas), 42, 'ἔρως τοῦ καλοῦ.', 'Amor de lo bello.', 'Amor pulchri.'),
((SELECT IFNULL(MAX(id_cita), 0) + 9 FROM citas), 42, 'πόλις ψυχῆς εἰκών.', 'La ciudad es imagen del alma.', 'Civitas animae imago est.'),
((SELECT IFNULL(MAX(id_cita), 0) + 10 FROM citas), 42, 'σοφία ἀρετή.', 'La sabiduría es virtud.', 'Sapientia virtus est.');

-- 🔹 ARISTÓTELES (id_autor = 43) - 10 citas
INSERT INTO citas (id_cita, id_autor, cita_original, cita_es, cita_la) VALUES
((SELECT IFNULL(MAX(id_cita), 0) + 1 FROM citas), 43, 'Ὁ ἄνθρωπος φύσει πολιτικὸν ζῷον.', 'El hombre es un animal político.', 'Homo natura animal politicum est.'),
((SELECT IFNULL(MAX(id_cita), 0) + 2 FROM citas), 43, 'ἡ εὐδαιμονία τέλος τῆς ζωῆς.', 'La felicidad es el fin de la vida.', 'Felicitas finis vitae est.'),
((SELECT IFNULL(MAX(id_cita), 0) + 3 FROM citas), 43, 'ἡ ἀρετὴ ἕξις προαιρετική.', 'La virtud es un hábito electivo.', 'Virtus habitus electivus est.'),
((SELECT IFNULL(MAX(id_cita), 0) + 4 FROM citas), 43, 'τὸ μέσον ἄριστον.', 'El justo medio es lo mejor.', 'Medium optimum est.'),
((SELECT IFNULL(MAX(id_cita), 0) + 5 FROM citas), 43, 'οὐθὲν ἐν τῷ νοῒ ὃ μὴ πρότερον ἐν ταῖς αἰσθήσεσιν.', 'Nada hay en el intelecto que no haya estado antes en los sentidos.', 'Nihil est in intellectu quod non prius fuerit in sensu.'),
((SELECT IFNULL(MAX(id_cita), 0) + 6 FROM citas), 43, 'ἡ φύσις οὐδὲν ποιεῖ μάτην.', 'La naturaleza no hace nada en vano.', 'Natura nihil frustra facit.'),
((SELECT IFNULL(MAX(id_cita), 0) + 7 FROM citas), 43, 'ἡ πόλις φύσει ἐστίν.', 'La ciudad existe por naturaleza.', 'Civitas natura est.'),
((SELECT IFNULL(MAX(id_cita), 0) + 8 FROM citas), 43, 'ἡ ψυχὴ εἶδος σώματος.', 'El alma es la forma del cuerpo.', 'Anima forma corporis est.'),
((SELECT IFNULL(MAX(id_cita), 0) + 9 FROM citas), 43, 'ἡ φρόνησις ἀρετὴ διανοητική.', 'La prudencia es una virtud intelectual.', 'Prudentia virtus intellectualis est.'),
((SELECT IFNULL(MAX(id_cita), 0) + 10 FROM citas), 43, 'ὁ φίλος ἕτερος αὐτός.', 'El amigo es otro yo.', 'Amicus alter ego est.');

-- VERIFICACIÓN FINAL (30 citas nuevas)
SELECT a.autor_es, COUNT(*) as total_citas
FROM citas c 
JOIN autores a ON c.id_autor = a.id_autor 
WHERE a.id_autor IN (40,41,42,43,44)
GROUP BY a.id_autor, a.autor_es;
</sql><current_tab id="0"/></tab_sql></sqlb_project>
