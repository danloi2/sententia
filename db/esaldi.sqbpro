olumn index="5" value="95"/><column index="6" value="153"/><column index="7" value="240"/><column index="8" value="162"/><column index="9" value="300"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="epocas" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="68"/><column index="2" value="154"/><column index="3" value="77"/><column index="4" value="59"/><column index="5" value="162"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="idiomas" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="0" mode="0"/></sort><column_widths><column index="1" value="49"/><column index="2" value="56"/><column index="3" value="84"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="naciones" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="73"/><column index="2" value="75"/><column index="3" value="73"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="sqlite_sequence" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="52"/><column index="2" value="49"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="vista_citas_detallada" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="54"/><column index="2" value="300"/><column index="3" value="300"/><column index="4" value="300"/><column index="5" value="67"/><column index="6" value="240"/><column index="7" value="294"/><column index="8" value="74"/><column index="9" value="77"/><column index="10" value="91"/><column index="11" value="56"/><column index="12" value="73"/><column index="13" value="123"/><column index="14" value="169"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">SELECT name, sql 
FROM sqlite_master 
WHERE type = 'index' AND tbl_name = 'citas';</sql><sql name="Comprobar clave &amp;foránea">CREATE VIEW IF NOT EXISTS vista_citas_detallada AS
SELECT 
    c.id_cita,
    c.cita_original,
    c.cita_es,
    c.cita_la,
    a.id_autor,
    a.autor_es,
    a.autor_la,
    i.id_idioma,
    i.idioma_es,
    i.idioma_la,
    i.codigo,
    n.id_nacion,
    n.nacion_es,
    n.nacion_la
FROM citas c
LEFT JOIN autores a ON c.id_autor = a.id_autor
LEFT JOIN idiomas i ON c.id_idioma = i.id_idioma
LEFT JOIN naciones n ON a.id_nacion = n.id_nacion;</sql><current_tab id="1"/></tab_sql></sqlb_project>
