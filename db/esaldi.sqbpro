"169"/><column index="15" value="154"/><column index="16" value="162"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="sqlite_sequence" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="52"/><column index="2" value="49"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1"></sql><sql name="Editar vista vista_citas_detallada">DROP VIEW IF EXISTS &quot;main&quot;.&quot;vista_citas_detallada&quot;;

CREATE VIEW vista_citas_detallada AS
SELECT 
    c.id_cita,
    c.cita_original,
    c.cita_es,
    c.cita_la,
    a.id_autor,
    a.autor_es,
    a.autor_la,
    i.id_idioma,
    i.idioma_es,
    i.idioma_la,
    i.codigo,
    n.id_nacion,
    n.nacion_es,
    n.nacion_la,
    e.epoca_es,
    e.epoca_la
FROM citas c
LEFT JOIN autores a ON c.id_autor = a.id_autor
LEFT JOIN epocas e ON a.id_epoca = e.id_epoca
LEFT JOIN idiomas i ON c.id_idioma = i.id_idioma
LEFT JOIN naciones n ON a.id_nacion = n.id_nacion;
</sql><sql name="Editar vista vista_citas_detallada">BEGIN TRANSACTION;

-- 1️⃣ Crear tabla temporal para autores con IDs nuevos
CREATE TEMP TABLE autores_temp AS
SELECT
    ROW_NUMBER() OVER (ORDER BY id_autor) AS new_id,
    autor_es,
    nacimiento_ano,
    fallecimiento_ano,
    biografia_es,
    autor_la,
    id_epoca,
    id_nacion,
    biografia_la,
    id_autor AS old_id
FROM autores;

-- 2️⃣ Crear tabla temporal para actualizar citas con los nuevos IDs de autores
CREATE TEMP TABLE citas_temp AS
SELECT
    c.id_cita,
    c.cita_original,
    c.cita_es,
    c.cita_la,
    a.new_id AS id_autor,
    c.id_idioma
FROM citas c
JOIN autores_temp a ON c.id_autor = a.old_id;

-- 3️⃣ Borrar datos antiguos
DELETE FROM citas;
DELETE FROM autores;

-- 4️⃣ Insertar autores con nuevos IDs
INSERT INTO autores (
    id_autor,
    autor_es,
    nacimiento_ano,
    fallecimiento_ano,
    biografia_es,
    autor_la,
    id_epoca,
    id_nacion,
    biografia_la
)
SELECT
    new_id,
    autor_es,
    nacimiento_ano,
    fallecimiento_ano,
    biografia_es,
    autor_la,
    id_epoca,
    id_nacion,
    biografia_la
FROM autores_temp;

-- 5️⃣ Insertar citas con IDs de autor actualizados
INSERT INTO citas (
    id_cita,
    cita_original,
    cita_es,
    cita_la,
    id_autor,
    id_idioma
)
SELECT
    id_cita,
    cita_original,
    cita_es,
    cita_la,
    id_autor,
    id_idioma
FROM citas_temp;

-- 6️⃣ Actualizar sqlite_sequence para mantener AUTOINCREMENT correcto
UPDATE sqlite_sequence
SET seq = (SELECT MAX(id_autor) FROM autores)
WHERE name='autores';

UPDATE sqlite_sequence
SET seq = (SELECT MAX(id_cita) FROM citas)
WHERE name='citas';

-- 7️⃣ Borrar tablas temporales
DROP TABLE autores_temp;
DROP TABLE citas_temp;

COMMIT;

</sql><sql name="Editar vista esaldi">DROP VIEW IF EXISTS &quot;main&quot;.&quot;esaldi&quot;;
CREATE VIEW esaldi AS
SELECT 
    c.id_cita,
    c.cita_original,
    c.cita_es,
    c.cita_la,
    a.id_autor,
    a.autor_es,
    a.autor_la,
    i.id_idioma,
    i.idioma_es,
    i.idioma_la,
    i.codigo,
    n.id_nacion,
    n.nacion_es,
    n.nacion_la,
    e.epoca_es,
    e.epoca_la
FROM citas c
LEFT JOIN autores a ON c.id_autor = a.id_autor
LEFT JOIN epocas e ON a.id_epoca = e.id_epoca
LEFT JOIN idiomas i ON c.id_idioma = i.id_idioma
LEFT JOIN naciones n ON a.id_nacion = n.id_nacion</sql><current_tab id="3"/></tab_sql></sqlb_project>
