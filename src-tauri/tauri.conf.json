{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sententiadiei",
  "version": "4.1.0",
  "identifier": "com.sententiadiei",
  "bundle": {
    "active": true,
    "targets": ["rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "rpm": {
        "depends": ["webkit2gtk3", "libappindicator3"]
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sententia Diei",
        "width": 900,
        "height": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://* data: asset: blob:; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; connect-src 'self' asset: ipc: http://ipc.localhost https://ipc.localhost"
    }
  },
  "build": {
    "beforeBuildCommand": "",
    "frontendDist": "../docs"
  }
}
