{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sententiadiei",
  "version": "4.0.0",
  "identifier": "com.sententiadiei",
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../docs/db/**/*",
      "../docs/js/**/*",
      "../docs/assets/**/*"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "Sententia Diei",
        "width": 900,
        "height": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://* data:; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; connect-src 'self' asset: ipc: http://ipc.localhost"
    }
  },
  "build": {
    "beforeBuildCommand": "",
    "frontendDist": "../docs"
  }
}
